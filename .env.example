# JWT signing key
JWT_KEY=asdfasdf

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_auth

# SMTP Email Configuration
# Configure these variables to route welcome emails, login alerts, and OTP codes to your actual email mailbox.
# For Gmail, set host to smtp.gmail.com, port to 587, and use an App Password for SMTP_PASS.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mock-user@ethereal.email
SMTP_PASS=mock-pass
SMTP_FROM="E-Commerce Marketplace" <noreply@ecommerce.com>
